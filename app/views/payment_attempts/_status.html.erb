<%# Subscribe this browser tab to real-time updates for this PaymentAttempt.
    The IPN controller calls Turbo::StreamsChannel.broadcast_replace_to(payment, ...)
    which replaces the #payment_status div without any page refresh or JS polling. %>
<%= turbo_stream_from payment %>

<% case payment.stk_status %>
<% when "pending", "processing" %>
  <% if payment.redirect_url.present? %>
    <%# Pesapal hosted payment page — user completes payment inside this iframe.
        The phone number is pre-filled on Pesapal's side from the billing_address
        we passed in submit_order. After the user pays, Pesapal sends the IPN
        callback and the Turbo broadcast replaces this entire div automatically. %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-3">
        <p class="fw-semibold mb-2">Complete your payment below</p>
        <p class="text-muted small mb-3">
          Enter your M-Pesa number on the Pesapal page and confirm the payment.
          This page will update automatically once payment is received.
        </p>
      </div>
      <div style="width:100%; min-height:520px; border:0; overflow:hidden;">
        <iframe src="<%= payment.redirect_url %>"
                style="width:100%; height:520px; border:none;"
                allow="payment"
                title="Pesapal Payment">
        </iframe>
      </div>
    </div>
  <% else %>
    <%# Simulation / fallback: no redirect_url (Pesapal not configured) %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-4">
        <div class="d-flex justify-content-center mb-3">
          <div class="spinner-border text-success" role="status" style="width:2.5rem;height:2.5rem;">
            <span class="visually-hidden">Loading…</span>
          </div>
        </div>
        <p class="fw-semibold mb-1">Payment request sent!</p>
        <p class="text-muted mb-0 small">
          Check your phone and enter your M-Pesa PIN to complete the payment.
          This page will update automatically.
        </p>
      </div>
    </div>
  <% end %>

<% when "completed" %>
  <div class="card border-0 border-start border-success border-4 shadow-sm">
    <div class="card-body d-flex align-items-center gap-3 py-3">
      <span class="fs-2">✅</span>
      <div>
        <p class="fw-semibold text-success mb-0">Payment received — booking confirmed!</p>
        <p class="text-muted small mb-0">Reference: <%= payment.provider_reference %></p>
      </div>
    </div>
  </div>

<% when "failed" %>
  <div class="card border-0 border-start border-danger border-4 shadow-sm">
    <div class="card-body d-flex align-items-center gap-3 py-3">
      <span class="fs-2">❌</span>
      <div>
        <p class="fw-semibold text-danger mb-1">Payment failed or was cancelled.</p>
        <%= link_to "Try again",
              new_payment_attempt_path(viewing_appointment_id: payment.viewing_appointment_id),
              class: "wantu-btn wantu-btn--outline btn-sm" %>
      </div>
    </div>
  </div>

<% when "timed_out" %>
  <div class="card border-0 border-start border-warning border-4 shadow-sm">
    <div class="card-body d-flex align-items-center gap-3 py-3">
      <span class="fs-2">⏱️</span>
      <div>
        <p class="fw-semibold text-warning mb-1">We didn't get a response in time.</p>
        <p class="text-muted small mb-1">
          The M-Pesa prompt expired. Please try again — no money was deducted.
        </p>
        <%= link_to "Try again",
              new_payment_attempt_path(viewing_appointment_id: payment.viewing_appointment_id),
              class: "wantu-btn wantu-btn--outline btn-sm" %>
      </div>
    </div>
  </div>

<% end %>

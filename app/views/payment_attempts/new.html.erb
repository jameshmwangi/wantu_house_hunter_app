<% content_for :title, t('payment_attempts.title') %>

<section class="container py-4">
  <%# Breadcrumb %>
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><%= link_to t('viewing_appointments.title'), new_listing_viewing_appointment_path(@listing) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('payment_attempts.title') %></li>
    </ol>
  </nav>

  <h2 class="font-serif mb-4"><%= t('payment_attempts.complete_payment', default: 'Complete Payment') %></h2>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <%# Property summary card %>
      <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3">
          <% if @listing.property_images.any? && @listing.property_images.first.image.attached? %>
            <%= image_tag @listing.property_images.first.image,
                class: "rounded", style: "width:80px;height:80px;object-fit:cover;",
                alt: @listing.title %>
          <% end %>
          <div>
            <span class="wantu-badge wantu-badge--<%= @listing.need_type %>">
              <%= t("listings.need_type.#{@listing.need_type}") %>
            </span>
            <h5 class="mb-0"><%= @listing.title %>, <%= @listing.location.area_name %></h5>
            <p class="mb-0 text-muted"><%= @listing.room_layout.humanize %> &middot; <%= @listing.location.sub_county %></p>
            <span class="text-success fw-bold">Ksh <%= number_with_delimiter(@listing.price) %>/<%= @listing.price_period %></span>
          </div>
        </div>
      </div>

      <%# Listing owner card %>
      <div class="card mb-4">
        <div class="card-body">
          <small class="text-muted text-uppercase"><%= t('viewing_appointments.listing_owner') %></small>
          <div class="d-flex align-items-center gap-3 mt-2">
            <div class="wantu-avatar <%= @listing.user.avatar_role_class %>">
              <%= avatar_for(@listing.user) %>
            </div>
            <div>
              <strong><%= @listing.user.full_name %></strong>
              <p class="mb-0 text-muted"><%= t("roles.#{@listing.user.role}") %> &middot; <%= @listing.user.listings.published.count %> <%= t('dashboard.my_listings') %></p>
            </div>
          </div>
        </div>
      </div>

      <%# Live payment status area — replaced by Turbo Stream after form submit %>
      <div id="payment_status">
        <%= render 'payment_attempts/status', payment: @payment if @payment %>
      </div>

      <%# Payment form %>
      <div id="payment_form">
        <div class="card mb-4 border-0 shadow-sm">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
              <span class="text-muted"><%= t('viewing_appointments.viewing_fee', default: 'Viewing Appointment Fee') %></span>
              <span class="fs-4 fw-bold text-success">Ksh <%= number_with_delimiter(@appointment.fee_amount) %></span>
            </div>

            <div class="mb-3">
              <label class="text-muted small text-uppercase fw-semibold d-block mb-2">Supported Payment Methods</label>
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">
                  📱 M-Pesa
                </span>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 fs-6">
                  📱 Airtel Money
                </span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fs-6">
                  💳 Visa / Mastercard
                </span>
              </div>
            </div>

            <%= form_with url: payment_attempts_path, method: :post,
                  id: "checkout_form",
                  data: { turbo: false,
                          controller: "disable-on-submit",
                          action: "submit->disable-on-submit#disable" } do |f| %>
              <%= f.hidden_field :viewing_appointment_id, value: @appointment.id, name: :viewing_appointment_id %>
              <input type="hidden" name="payment_method" value="mpesa">

              <%# Phone number field — pre-filled from user profile %>
              <div class="mb-4">
                <label class="form-label small fw-medium" for="phone_number">
                  <%= t('payment_attempts.mpesa_number', default: 'Contact / Phone Number') %>
                </label>
                <input type="tel"
                       id="phone_number"
                       name="phone_number"
                       class="form-control"
                       placeholder="2547XXXXXXXX"
                       value="<%= current_user.phone_number %>">
                <div class="form-text text-muted">
                  Used for pre-filling your details on the secure Pesapal checkout page.
                </div>
              </div>

              <%= f.submit t('viewing_appointments.submit_payment', default: "Proceed to Pay Ksh #{number_with_delimiter(@appointment.fee_amount)}"),
                    class: "wantu-btn wantu-btn--primary w-100 py-3 fs-5",
                    data: { "disable-on-submit-target": "submit" } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
